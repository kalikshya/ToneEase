{
  "manifest_version": 3,
  "name": "ToneEase",
  "version": "1.0",
  "description": "Smart Tone Assistant for better communication",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}